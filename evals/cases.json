{
  "reference_date": "2026-08-31",
  "cases": [
    {
      "id": "expired_regular_item_no_escalation",
      "description": "An expired regular item is blocked without human review.",
      "messages": [
        "Hi, I want to return an item.",
        "My order ID is CL1001 and my email is maya@example.com."
      ],
      "expected": {
        "required_tool_calls": [
          "verify_order",
          "start_return"
        ],
        "forbidden_tool_calls": [
          "request_human_support",
          "check_return_eligibility"
        ],
        "human_review_required": false,
        "response_requirements": [
          "Explain that the item is outside the 30-day return window.",
          "Do not say that human review is required.",
          "Do not claim that a return label was created."
        ],
        "tool_sequence": [
          "verify_order",
          "start_return"
        ],
        "return_rows": 0,
        "support_rows": 0,
        "tool_expectations": {
          "verify_order": [
            {
              "arguments": {
                "order_id": "CL1001",
                "email": "maya@example.com"
              },
              "output": {
                "verified": true
              }
            }
          ],
          "start_return": [
            {
              "arguments": {
                "item_id": "it00001",
                "reason": null
              },
              "output": {
                "status": "return_not_created",
                "decision": "blocked"
              }
            }
          ]
        }
      },
      "requirements": [
        "AUTH-01",
        "WRITE-01",
        "WRITE-02"
      ]
    },
